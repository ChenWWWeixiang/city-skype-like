{
  "name": "city-skype-like",
  "version": "1.0.0",
  "description": "都市天际线2 风格的城市建设模拟游戏（3D 网页版 + SQLite 后端模拟）",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "build": "node build.js",
    "start": "npm run build && node server/index.js",
    "dev": "node build.js && node --watch server/index.js",
    "serve": "node server/index.js",
    "test": "node test/smoke.mjs && node test/flow.mjs && node test/conservation.mjs && node test/terrain.mjs && node test/lab.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "three": "^0.186.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  }
}
